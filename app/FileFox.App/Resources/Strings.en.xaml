    <sys:String x:Key="OnboardFinishOutputFormat">Filing to: {0}</sys:String>
    <sys:String x:Key="OnboardFinishClientsFormat">Clients added: {0}</sys:String>
    <sys:String x:Key="OnboardStartButton">Start Using FileFox</sys:String>

    <sys:String x:Key="OnboardBackButton">Back</sys:String>
    <sys:String x:Key="OnboardNextButton">Next</sys:String>


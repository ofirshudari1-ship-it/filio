    <sys:String x:Key="MinimizeToTrayTooltip">When enabled, pressing X hides Filio to the tray instead of quitting. Filio continues filing in the background.</sys:String>
    <sys:String x:Key="MinimizeToTraySubtitle">Filio keeps running in the background when you close this window.</sys:String>
    <sys:String x:Key="LogRetentionLabel">Activity Log Retention</sys:String>

    <!-- טאב עדכונים -->
    <sys:String x:Key="UpdatesIntro">Filio יכול לבדוק גרסאות חדשות ולהתקין אותן במקום - בלי צורך להוריד או להריץ קובץ התקנה בעצמכם.</sys:String>
    <sys:String x:Key="CurrentVersionLabel">גרסה נוכחית:</sys:String>
    <sys:String x:Key="CheckForUpdatesButton">בדיקת עדכונים</sys:String>
    <sys:String x:Key="CheckingStatus">בודק...</sys:String>
    <sys:String x:Key="UpToDateStatus">אתם מעודכנים לגרסה האחרונה.</sys:String>
    <sys:String x:Key="UpdateAvailableStatus">גרסה {0} זמינה.</sys:String>
    <sys:String x:Key="UpdateErrorStatus">לא ניתן היה לבדוק עדכונים. ודאו שכתובת העדכונים תקינה ושיש חיבור לאינטרנט.</sys:String>
    <sys:String x:Key="UpdateInsecureUrlStatus">🔒 נחסם מטעמי אבטחה: כתובת העדכונים חייבת להתחיל ב-https:// - קישור http:// רגיל היה יכול לאפשר למישהו לשנות את קובץ ההתקנה בדרך.</sys:String>
    <sys:String x:Key="UpdateIntegrityFailedStatus">🔒 נחסם מטעמי אבטחה: הקובץ שהתקבל לא תואם את החתימה שפורסמה לגרסה הזו, ולכן הוא נמחק במקום להיפתח. ניתן לנסות שוב מאוחר יותר, או לבדוק את כתובת העדכונים.</sys:String>
    <sys:String x:Key="DownloadAndInstallButton">הורדה והתקנת עדכון</sys:String>
    <sys:String x:Key="OpenReleasePageButton">פתיחת עמוד הגרסה</sys:String>
    <sys:String x:Key="UpdateNowButton">עדכן עכשיו</sys:String>
    <sys:String x:Key="DownloadingStatus">מוריד עדכון...</sys:String>
    <sys:String x:Key="InstallingStatus">מתקין - Filio יופעל מחדש אוטומטית.</sys:String>
    <sys:String x:Key="AutoCheckOnStartupCheck">בדיקת עדכונים אוטומטית בהפעלה</sys:String>
    <sys:String x:Key="AutoInstallUpdatesCheck">הורדה והתקנה אוטומטית של עדכונים</sys:String>
    <sys:String x:Key="AutoInstallUpdatesHelp">כשמתגלה גרסה חדשה, Filio מוריד ומתקין אותה ברקע - בלי צורך בלחיצות. כבוי כברירת מחדל; כשזה כבוי, Filio רק מודיע לכם ואתם מתקינים בעזרת כפתור "עדכן עכשיו".</sys:String>
    <sys:String x:Key="UpdateAutoInstallingStatus">התגלתה גרסה חדשה - מוריד ומתקין אוטומטית...</sys:String>
    <sys:String x:Key="UpdateFallbackAfterFailureStatus">העדכון האוטומטי לא הצליח להשלים, אז Filio השאיר את הגרסה הנוכחית פועלת. השתמשו ב"פתיחת עמוד הגרסה" כדי להוריד בעצמכם.</sys:String>
    <sys:String x:Key="UpdateFeedUrlLabel">כתובת עדכונים (מתקדם)</sys:String>
    <sys:String x:Key="UpdateFeedUrlHelp">קובץ JSON שמתאר את הגרסה האחרונה. השאירו ריק כדי לבטל בדיקת עדכונים.</sys:String>
    <sys:String x:Key="UpdateFeedUrlTooltip">חייבת להיות כתובת https://. Filio מסרב לקישורי http:// רגילים, וכאשר כתובת העדכונים מפרסמת גיבוב sha256, מאמת את קובץ ההתקנה שהתקבל מולו לפני שמריצים משהו.</sys:String>
    <sys:String x:Key="UpdateSecurityNote">🔒 מטעמי אבטחה, גם הכתובת הזו וגם קישור ההתקנה שהיא מפנה אליו חייבים להיות https://. אם כתובת העדכונים כוללת שדה "sha256", Filio מאמת את הגיבוב של הקובץ שהתקבל לפני ההתקנה - ומוחק אותו במקום להריץ אותו אם הגיבוב לא תואם.</sys:String>
    <sys:String x:Key="ChangelogLabel">מה חדש:</sys:String>

    <!-- טאב עזרה -->
    <sys:String x:Key="HelpVersionPrefix">גרסה</sys:String>
    <sys:String x:Key="HelpDescription">Filio עוקב אחרי תיקיית ההורדות שלכם, מזהה אוטומטית אם קובץ הוא חשבונית, חוזה או דוח, מזהה את הלקוח הרלוונטי, ומעביר אותו לתיקייה מסודרת לפי לקוח ← שנה ← סוג מסמך. הכל רץ מקומית על המחשב, ללא שליחת קבצים לאף שרת חיצוני.</sys:String>
    <sys:String x:Key="HelpClosingNote">סגירת החלון לא סוגרת את Filio - הוא ממשיך לפעול באזור ההתראות (ליד השעון). ניתן להשהות ולהפעיל מחדש בכל רגע מהכפתור בכותרת או מתפריט אייקון המגש.</sys:String>
    <sys:String x:Key="HelpHowItWorksTitle">איך זה עובד</sys:String>
    <sys:String x:Key="HelpHowItWorksBody">1.  קובץ חדש נשמר בתיקיית המעקב.
2.  Filio ממתין שההורדה תסתיים לגמרי.
3.  הוא קורא את שם הקובץ (ואת תוכן ה-PDF, כשזמין) ומשווה מול חוקי הסיווג והלקוחות שהגדרתם.
4.  הקובץ עובר אל תיקיית יעד \ לקוח \ שנה \ סוג.
5.  מתקבלת התראה קצרה, והפעולה נרשמת ביומן - עם אפשרות ביטול בקליק אחד אם ההתאמה טעתה.</sys:String>
    <sys:String x:Key="HelpTipsTitle">טיפים</sys:String>
    <sys:String x:Key="HelpTipsBody">• הוסיפו לכל לקוח את כל הווריאציות הנפוצות של השם כ"כינויים" - ככל שיש יותר וריאציות, ההתאמה טובה יותר.
• PDF סרוק (תמונה בלבד, ללא שכבת טקסט) יזוהה רק לפי שם הקובץ.
• אם קובץ מתויק לעיתים קרובות תחת "לקוח לא מזוהה" או "לא מזוהה" - עדכנו את טאב החוקים או הלקוחות, בלי צורך להתקין מחדש.</sys:String>
    <sys:String x:Key="OpenOutputFolderButton">פתיחת תיקיית היעד</sys:String>
    <sys:String x:Key="OpenLogsFolderButton">פתיחת תיקיית ההגדרות והיומן</sys:String>
    <sys:String x:Key="RerunSetupWizardButton">הרצת אשף ההגדרה מחדש</sys:String>
    <sys:String x:Key="BackupSettingsTitle">גיבוי ושחזור</sys:String>
    <sys:String x:Key="BackupSettingsBody">שמרו את הלקוחות, החוקים וההעדפות שלכם לקובץ - שימושי לפני התקנה מחדש של Filio, או להעברת ההגדרות למחשב אחר.</sys:String>
    <sys:String x:Key="ExportSettingsButton">ייצוא הגדרות...</sys:String>
    <sys:String x:Key="ImportSettingsButton">ייבוא הגדרות...</sys:String>
    <sys:String x:Key="ExportSettingsSuccess">✅ ההגדרות יוצאו בהצלחה.</sys:String>
    <sys:String x:Key="ExportSettingsFailed">לא ניתן היה לשמור את הקובץ שם - ודאו שהמיקום אינו לקריאה בלבד ושיש מקום פנוי בכונן, ונסו שוב.</sys:String>
    <sys:String x:Key="ImportSettingsSuccess">✅ ההגדרות יובאו בהצלחה.</sys:String>
    <sys:String x:Key="ImportSettingsFailed">לא ניתן היה לקרוא את הקובץ - ייתכן שזה לא קובץ ייצוא תקין של Filio.</sys:String>


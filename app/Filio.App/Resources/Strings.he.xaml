<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- מותג -->
    <sys:String x:Key="AppName">Filio</sys:String>
    <sys:String x:Key="AppTagline">ההורדות מתייקות את עצמן</sys:String>
    <sys:String x:Key="WindowTitle">Filio — הגדרות</sys:String>

    <!-- חיווי סטטוס -->
    <sys:String x:Key="StatusActive">פעיל</sys:String>
    <sys:String x:Key="StatusPaused">מושהה</sys:String>
    <sys:String x:Key="PauseButton">השהה</sys:String>
    <sys:String x:Key="ResumeButton">הפעל מחדש</sys:String>

    <!-- מסך פתיחה -->
    <sys:String x:Key="SplashLoadingSettings">טוען הגדרות…</sys:String>
    <sys:String x:Key="SplashStartingWatcher">מפעיל מעקב קבצים…</sys:String>
    <sys:String x:Key="SplashReady">מוכן!</sys:String>

    <!-- טאבים -->
    <sys:String x:Key="TabGeneral">⚙️ הגדרות</sys:String>
    <sys:String x:Key="TabClients">👥 לקוחות</sys:String>
    <sys:String x:Key="TabRules">🧭 חוקי סיווג</sys:String>
    <sys:String x:Key="TabActivity">📋 פעילות</sys:String>
    <sys:String x:Key="TabUpdates">🔄 עדכונים</sys:String>
    <sys:String x:Key="TabHelp">❓ עזרה</sys:String>

    <!-- טאב כללי -->
    <sys:String x:Key="WatchFolderLabel">תיקיית מעקב (בדרך כלל ההורדות)</sys:String>
    <sys:String x:Key="WatchFoldersLabel">תיקיות מעקב</sys:String>
    <sys:String x:Key="WatchFoldersSubtitle">Filio עוקב אחרי כל התיקיות האלה במקביל - הוסיפו שולחן עבודה, תיקיית צירופי מייל, או כל מקום אחר שקבצים נוחתים בו.</sys:String>
    <sys:String x:Key="AddWatchFolderButton">+ הוספת תיקייה</sys:String>
    <sys:String x:Key="RemoveWatchFolderButton">מחיקת שורה נבחרת</sys:String>
    <sys:String x:Key="BrowseButton">בחירה...</sys:String>
    <sys:String x:Key="OutputFolderLabel">לאן לתייק</sys:String>
    <sys:String x:Key="OutputFolderSubtitle">Filio ייצור כאן לבד תיקיות מסודרות, ממוינות לפי לקוח, שנה וסוג מסמך.</sys:String>
    <sys:String x:Key="OutputFolderWarning">⚠ תיקיית היעד לא יכולה להיות זהה לאף תיקיית מעקב או נמצאת בתוכה</sys:String>
    <sys:String x:Key="CloudSyncInfoFormat">☁ התיקייה הזו מסתנכרנת עם {0} - Filio ימתין שקבצים יסיימו להסתנכרן לפני שהוא נוגע בהם.</sys:String>
    <sys:String x:Key="DetectDuplicatesCheck">לתפוס קבצים כפולים אוטומטית</sys:String>
    <sys:String x:Key="OrganizeInstallersCheck">לתייק גם קובצי התקנה של תוכנות (.exe, .msi)</sys:String>
    <sys:String x:Key="OrganizeInstallersSubtitle">כבוי כברירת מחדל - לפעמים רוצים להריץ קובץ התקנה מיד. כשמופעל, הוא הולך לתיקיית "_Installers" נפרדת, לא מעורב עם מסמכי לקוחות.</sys:String>
    <sys:String x:Key="OrganizeInstallersTooltip">לקובצי התקנה אין "לקוח" או "סוג מסמך" כמו לחשבוניות, אז הם מקבלים תיקייה פשוטה משלהם במקום לעבור דרך מנוע הסיווג.</sys:String>
    <sys:String x:Key="EnableDefenderScanCheck">לבדוק כל קובץ מול Windows Defender קודם</sys:String>
    <sys:String x:Key="EnableDefenderScanSubtitle">משתמש באנטי-וירוס החינמי והמובנה של Windows - לא מנוע אבטחה ש-Filio המציא בעצמו. קובץ ש-Defender מסמן כאיום נשאר בדיוק איפה שהוא ולעולם לא מתויק.</sys:String>
    <sys:String x:Key="EnableDefenderScanTooltip">מריץ סריקת Defender חד-פעמית על כל קובץ חדש לפני שהוא מתויק. אם Defender לא זמין, הקובץ מתויק כרגיל עם הערה ביומן - זו בדיקה נוספת, לא תחליף להגנת זמן-אמת.</sys:String>
    <sys:String x:Key="ReviewLowConfidenceCheck">לשאול לפני תיוק כשלא זוהה שום לקוח</sys:String>
    <sys:String x:Key="ReviewLowConfidenceSubtitle">אם Filio לא הצליח להתאים קובץ לאף לקוח בכלל, הוא ישאיר אותו במקומו וימתין שתבחרו את הלקוח הנכון מטאב הפעילות - במקום לתייק אותו תחת "לקוח לא ידוע".</sys:String>
    <sys:String x:Key="ReviewLowConfidenceTooltip">כבוי כברירת מחדל, כדי לא לשנות התנהגות קיימת בלי שביקשתם. הפעילו את זה אם אתם מעדיפים לבדוק קבצים לא-ברורים פעם אחת וללמד את Filio, במקום למצוא אותם מאוחר יותר תחת "לקוח לא ידוע".</sys:String>
    <sys:String x:Key="WatchedExtensionsLabel">סוגי קבצים למעקב</sys:String>
    <sys:String x:Key="WatchedExtensionsSubtitle">רק סוגי הקבצים האלה נגועים בכלל - כל השאר (תמונות, ZIP, וידאו, קבצי התקנה...) נשארים בתיקיית המעקב בלי שנוגעים בהם.</sys:String>
    <sys:String x:Key="WatchedExtensionsRequired">יש לרשום לפחות סיומת קובץ אחת למעקב (למשל .pdf).</sys:String>
    <sys:String x:Key="EnableImageOcrCheck">לקרוא טקסט בתוך תמונות וצילומי מסך (OCR מקומי)</sys:String>
    <sys:String x:Key="EnableImageOcrSubtitle">מאפשר ל-Filio לסווג צילום של חשבונית או קבלה לפי התוכן שלו, לא רק לפי שם הקובץ. רץ לגמרי על המחשב - איטי בכמה שניות לתמונה, שום דבר לא מועלה לשום מקום.</sys:String>
    <sys:String x:Key="EnableImageOcrTooltip">משתמש במנוע זיהוי טקסט מקומי (Tesseract) שמגיע מובנה עם Filio - בלי חשבון, בלי חיבור לאינטרנט, בלי עלות. כבו את זה אם אתם מעדיפים לסווג תמונות לפי שם הקובץ בלבד, לטובת מהירות.</sys:String>
    <sys:String x:Key="IgnorePatternsLabel">אף פעם לא לגעת בקבצים המכילים (אופציונלי)</sys:String>
    <sys:String x:Key="IgnorePatternsSubtitle">טקסט מופרד בפסיקים - כל קובץ ששמו מכיל אחד מהם תמיד ידולג, גם אם הסיומת שלו נצפית.</sys:String>
    <sys:String x:Key="FolderOrderLabel">מבנה תיקיות</sys:String>
    <sys:String x:Key="FolderOrderClientYearType">לקוח ← שנה ← סוג (ברירת מחדל)</sys:String>
    <sys:String x:Key="FolderOrderYearClientType">שנה ← לקוח ← סוג</sys:String>
    <sys:String x:Key="FolderOrderTypeClientYear">סוג ← לקוח ← שנה</sys:String>
    <sys:String x:Key="WatchedExtensionsTooltip">סיומות קבצים מופרדות בפסיקים, למשל ".pdf, .docx". כל קובץ שהסיומת שלו לא רשומה כאן נשאר בתיקיית המעקב בלי שנוגעים בו, לא משנה מה הוא.</sys:String>
    <sys:String x:Key="IgnorePatternsTooltip">טקסט מופרד בפסיקים. קובץ ידולג לתמיד אם שמו מכיל אחד מהם - שימושי לטיוטות, תבניות או קבצים שלעולם לא רוצים לתייק אוטומטית.</sys:String>
    <sys:String x:Key="FolderOrderTooltip">קובע את מבנה התיקיות מתחת לתיקיית היעד - מה מגיע ראשון, שני ושלישי מבין לקוח / שנה / סוג.</sys:String>
    <sys:String x:Key="DetectDuplicatesTooltip">משווה את תוכן הקובץ בפועל (לא רק את השם) לעומת כל מה שתויק בעבר. התאמה מדויקת מנותבת ל"כפילויות אפשריות" במקום לדרוס משהו בשקט.</sys:String>
    <sys:String x:Key="StartWithWindowsCheck">להתחיל לרוץ לבד כשהמחשב נדלק</sys:String>
    <sys:String x:Key="StartWithWindowsTooltip">מציג את המצב האמיתי כרגע ברישום ההפעלה של Windows (לא רק העדפה שמורה) - אם זה אי פעם נראה לא נכון, שמירת המסך הזה מתקנת את זה מיד.</sys:String>
    <sys:String x:Key="ShowNotificationsCheck">להראות התראה על כל קובץ שתויק</sys:String>
    <sys:String x:Key="NotifyOnlyOnFailureCheck">להתריע רק כשתיוק נכשל</sys:String>
    <sys:String x:Key="NotifyOnlyOnFailureTooltip">מדלג על הודעת המגש עבור קבצים שתויקו בהצלחה - עדיין תקבלו התראה בכל פעם שתיוק נכשל או דורש בדיקה.</sys:String>
    <sys:String x:Key="PauseCheck">להשהות זמנית (Filio לא יגע בקבצים)</sys:String>
    <sys:String x:Key="FileActionLabel">כשמתייקים קובץ</sys:String>
    <sys:String x:Key="MoveOption">להעביר אותו (הוא נעלם מההורדות)</sys:String>
    <sys:String x:Key="CopyOption">להעתיק אותו (המקור נשאר בהורדות)</sys:String>
    <sys:String x:Key="SaveButton">💾 שמירת ההגדרות</sys:String>
    <sys:String x:Key="LanguageLabel">שפה</sys:String>
    <sys:String x:Key="LanguageEnglish">English (אנגלית)</sys:String>
    <sys:String x:Key="LanguageHebrew">עברית</sys:String>
    <sys:String x:Key="BehaviorCardTitle">איך Filio מתנהג</sys:String>
    <sys:String x:Key="BehaviorCardSubtitle">פשוט מדליקים/מכבים - אין צורך להבין מה קורה מאחורי הקלעים.</sys:String>
    <sys:String x:Key="BehaviorGroupMonitor">ניטור והפעלה</sys:String>
    <sys:String x:Key="BehaviorGroupSecurity">אבטחה</sys:String>
    <sys:String x:Key="BehaviorGroupOrganize">ארגון קבצים</sys:String>
    <sys:String x:Key="ThemeLabel">ערכת נושא</sys:String>
    <sys:String x:Key="ThemeLight">☀️ בהיר</sys:String>
    <sys:String x:Key="ThemeDark">🌙 כהה</sys:String>
    <sys:String x:Key="DisplayCardTitle">מראה ואפליקציה</sys:String>
    <sys:String x:Key="MinimizeToTrayCheck">מינימיזציה למגש המערכת בסגירת חלון</sys:String>
    <sys:String x:Key="MinimizeToTrayTooltip">כשמופעל, לחיצה על X מסתירה את Filio למגש במקום לסגור אותו. Filio ממשיך לתייק ברקע.</sys:String>
    <sys:String x:Key="MinimizeToTraySubtitle">Filio ממשיך לפעול ברקע גם כשסוגרים את החלון הזה.</sys:String>
    <sys:String x:Key="LogRetentionLabel">שמירת יומן פעילות</sys:String>
    <sys:String x:Key="LogRetentionDaysUnit">ימים (0 = שמור לנצח)</sys:String>
    <sys:String x:Key="LogRetentionSubtitle">רשומות ישנות יותר ינוקו אוטומטית בהפעלה הבאה של Filio.</sys:String>
    <sys:String x:Key="OnboardStartupTitle">להפעיל עם הפעלת Windows?</sys:String>
    <sys:String x:Key="OnboardStartupSubtitle">Filio עובד הכי טוב כשהוא עולה עם Windows — כך הוא לא מפספס אף קובץ.</sys:String>
    <sys:String x:Key="AdvancedSettingsHeader">⚙️ הגדרות מתקדמות (לא חובה)</sys:String>
    <sys:String x:Key="AdvancedSettingsIntro">לא חייבים לגעת כאן בכלל - ברירת המחדל מתאימה לרוב האנשים. פותחים את זה רק אם רוצים לכוונן בדיוק אילו קבצים Filio בודק.</sys:String>

    <!-- טאב לקוחות -->
    <sys:String x:Key="ClientsIntroTitle">הלקוחות שלכם</sys:String>
    <sys:String x:Key="ClientsIntro">הוסיפו כאן את הלקוחות שאתם מתייקים עבורם מסמכים. בעמודת "כינויים" רשמו כל צורה שהשם שלהם עשוי להופיע במסמך - ככל שתוסיפו יותר, Filio יזהה אותם טוב יותר.</sys:String>
    <sys:String x:Key="ClientsExample">לדוגמה: שם "עיצוב אקמה", כינויים "אקמה, Acme, Acme Ltd"</sys:String>
    <sys:String x:Key="AddClientButton">+ הוספת לקוח</sys:String>
    <sys:String x:Key="RemoveClientButton">מחיקת שורה נבחרת</sys:String>
    <sys:String x:Key="SaveClientsButton">שמירה</sys:String>
    <sys:String x:Key="ClientNameColumn">שם הלקוח / תיקייה</sys:String>
    <sys:String x:Key="ClientKeywordsColumn">כינויים נוספים (מופרדים בפסיק)</sys:String>
    <sys:String x:Key="ClientsEmptyTitle">עדיין לא הוגדרו לקוחות</sys:String>
    <sys:String x:Key="ClientsEmptySubtitle">מסמכים ללא התאמה יתויקו תחת "לקוח לא מזוהה"</sys:String>
    <sys:String x:Key="ConfirmDeleteClient">למחוק את הלקוח "{0}"?</sys:String>

    <!-- טאב חוקי סיווג -->
    <sys:String x:Key="RulesIntroTitle">איך Filio מבדיל בין סוגי מסמכים</sys:String>
    <sys:String x:Key="RulesIntro">לכל סוג מסמך, רשמו מילים שמזהות אותו - בתוך הקובץ (מילות מפתח בתוכן) או בשם הקובץ. שורה אחת מסומנת כ"ברירת מחדל" תופסת כל מסמך שלא תואם לאף חוק אחר.</sys:String>
    <sys:String x:Key="RulesExample">לדוגמה: סוג "חשבוניות", מילות מפתח בתוכן "חשבונית, חשבונית מס", תבניות בשם הקובץ "חשבונית, invoice"</sys:String>
    <sys:String x:Key="AddRuleButton">+ הוספת סוג מסמך</sys:String>
    <sys:String x:Key="RemoveRuleButton">מחיקת שורה נבחרת</sys:String>
    <sys:String x:Key="SaveRulesButton">שמירה</sys:String>
    <sys:String x:Key="TypeColumn">סוג מסמך</sys:String>
    <sys:String x:Key="ContentKeywordsColumn">מילות מפתח בתוכן</sys:String>
    <sys:String x:Key="FileNamePatternColumn">תבניות בשם הקובץ</sys:String>
    <sys:String x:Key="FallbackColumn">ברירת מחדל</sys:String>
    <sys:String x:Key="ConfirmDeleteRule">למחוק את סוג המסמך "{0}"?</sys:String>

    <!-- טאב יומן פעילות -->
    <sys:String x:Key="TotalFiledLabel">סה״כ תויקו:</sys:String>
    <sys:String x:Key="SucceededLabel">הצליחו:</sys:String>
    <sys:String x:Key="FailedLabel">נכשלו:</sys:String>
    <sys:String x:Key="RefreshButton">רענון</sys:String>
    <sys:String x:Key="UndoButton">↩ בטל פעולה נבחרת</sys:String>
    <sys:String x:Key="RetryButton">⟳ נסה שוב</sys:String>
    <sys:String x:Key="IgnoreFileButton">🚫 לעולם אל תתייק שוב</sys:String>
    <sys:String x:Key="FixClientButton">✏ תקן / תייק…</sys:String>
    <sys:String x:Key="RetryFileMissing">לא ניתן לנסות שוב - הקובץ המקורי כבר לא קיים במיקום המקור.</sys:String>
    <sys:String x:Key="ReassignFileMissing">לא ניתן לתקן רשומה זו - הקובץ כבר לא קיים (ייתכן שכבר הוזז, בוטל או נמחק).</sys:String>
    <sys:String x:Key="ReassignWindowTitle">תיקון / תיוק</sys:String>
    <sys:String x:Key="ReassignWindowHeading">בחרו את הלקוח והסוג הנכונים</sys:String>
    <sys:String x:Key="ReassignClientLabel">לקוח</sys:String>
    <sys:String x:Key="ReassignDocTypeLabel">סוג מסמך</sys:String>
    <sys:String x:Key="ReassignLearnLabel">לזכור את זה לפעם הבאה</sys:String>
    <sys:String x:Key="ReassignLearnHintFormat">Filio יוסיף את "{0}" ככינוי ללקוח הזה, כדי שקבצים דומים יזוהו אוטומטית מעכשיו.</sys:String>
    <sys:String x:Key="ReassignConfirmButton">תייק</sys:String>
    <sys:String x:Key="ReassignSuccessMessage">תויק נכון - תודה, Filio יזהה את התבנית הזו בפעם הבאה.</sys:String>
    <sys:String x:Key="ReassignFailureMessage">לא ניתן היה לתייק - ודאו שתיקיית היעד זמינה ונסו שוב.</sys:String>
    <sys:String x:Key="ReassignClientRequired">יש לבחור או להקליד שם לקוח.</sys:String>
    <sys:String x:Key="CancelButton">ביטול</sys:String>
    <sys:String x:Key="ConfirmIgnoreFile">להוסיף את "{0}" לרשימת ההתעלמות? קבצים בשם הזה לעולם לא יתויקו אוטומטית.</sys:String>
    <sys:String x:Key="TimeColumn">שעה</sys:String>
    <sys:String x:Key="SourceFileColumn">קובץ מקור</sys:String>
    <sys:String x:Key="DetectedTypeColumn">סוג</sys:String>
    <sys:String x:Key="DetectedClientColumn">לקוח</sys:String>
    <sys:String x:Key="DetectedDateColumn">תאריך מזוהה</sys:String>
    <sys:String x:Key="StatusColumn">סטטוס</sys:String>
    <sys:String x:Key="LogEmptyTitle">עדיין לא תויקו קבצים</sys:String>
    <sys:String x:Key="LogEmptySubtitle">ברגע שקובץ ינחת בתיקיית המעקב הוא יופיע כאן</sys:String>
    <sys:String x:Key="UndoSuccessMessage">הקובץ הוחזר למיקומו המקורי.</sys:String>
    <sys:String x:Key="UndoFailureMessage">לא ניתן היה לבטל - ייתכן שהקובץ כבר הוזז/נמחק.</sys:String>
    <sys:String x:Key="UndoLastNoneMessage">אין עדיין מה לבטל - שום קובץ לא תויק בהפעלה הנוכחית.</sys:String>
    <sys:String x:Key="LogStatusFiled">טופל</sys:String>
    <sys:String x:Key="LogStatusDuplicate">כפילות אפשרית</sys:String>
    <sys:String x:Key="LogStatusErrorFormat">שגיאה: {0}</sys:String>
    <sys:String x:Key="LogStatusThreatDetected">🛑 זוהה איום - נשאר בלי לגעת בו</sys:String>
    <sys:String x:Key="LogStatusNeedsReview">⏸ ממתין לבדיקה - לא זוהה לקוח</sys:String>
    <sys:String x:Key="ExplainNeedsReview">Filio לא הצליח להתאים את הקובץ הזה לאף לקוח מוכר, אז הוא ממתין כאן במקום להיות מתויק תחת "לקוח לא ידוע". השתמשו ב"תקן / תייק…" כדי לבחור לקוח וסוג נכונים.</sys:String>
    <sys:String x:Key="DefenderThreatDetected">Windows Defender סימן את הקובץ הזה כאיום. Filio השאיר אותו בדיוק במקומו ולא תייק אותו - בדקו בעצמכם (Windows Security ← היסטוריית הגנה) לפני שעושים איתו משהו.</sys:String>
    <sys:String x:Key="ExplainInstaller">תויק כקובץ התקנת תוכנה (.exe/.msi) - אלה הולכים לתיקייה משלהם במקום להתאים ללקוח או סוג מסמך.</sys:String>

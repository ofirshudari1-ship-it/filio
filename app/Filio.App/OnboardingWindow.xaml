<Window x:Class="Filio.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource OnboardWindowTitle}"
        KeyDown="OnboardingWindow_KeyDown"
        Height="580" Width="820" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource SurfaceBrush}">

    <Window.Resources>
        <Style x:Key="LangCard" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource NeutralButtonForegroundBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="24,28">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Brand rail ===== -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0F5348" Offset="0"/>
                    <GradientStop Color="#1E7F72" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="26,30,26,26">
                <StackPanel DockPanel.Dock="Top">
                    <Image Source="/Assets/filio-64.png" Width="40" Height="40" HorizontalAlignment="Left"/>
                    <TextBlock Text="{DynamicResource AppName}" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,10,0,0"/>
                    <TextBlock Text="{DynamicResource AppTagline}" Foreground="#DFF3EF" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel x:Name="StepIndicatorPanel" DockPanel.Dock="Bottom" Margin="0,0,0,4"/>
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1" Margin="40,36,40,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="StepHost" Grid.Row="0">

                <!-- Step 0: Welcome -->
                <StackPanel x:Name="StepWelcome" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource OnboardWelcomeTitle}" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource BrandPrimaryDarkBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource OnboardWelcomeTagline}" FontSize="14.5" Margin="0,14,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" LineHeight="21"/>
                    <StackPanel Margin="0,28,0,0">
                        <TextBlock Text="{DynamicResource OnboardWelcomeBullet1}" FontSize="14" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource OnboardWelcomeBullet2}" FontSize="14" Margin="0,0,0,10"/>
                        <TextBlock Text="{DynamicResource OnboardWelcomeBullet3}" FontSize="14"/>
                    </StackPanel>
                </StackPanel>

                <!-- Step 1: Language -->
                <StackPanel x:Name="StepLanguage" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource OnboardLanguageTitle}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryDarkBrush}"/>
                    <TextBlock Text="{DynamicResource OnboardLanguageSubtitle}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,26" TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="EnglishCard" Style="{StaticResource LangCard}" Click="EnglishCard_Click">
                            <StackPanel>
                                <TextBlock Text="🇺🇸" FontSize="32" HorizontalAlignment="Center"/>
                                <TextBlock Text="EN" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="English" FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" x:Name="HebrewCard" Style="{StaticResource LangCard}" Click="HebrewCard_Click">
                            <StackPanel>
                                <TextBlock Text="🇮🇱" FontSize="32" HorizontalAlignment="Center"/>
                                <TextBlock Text="עב" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock Text="עברית" FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Step 2: Folders -->
                <StackPanel x:Name="StepFolders" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource OnboardFoldersTitle}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryDarkBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource OnboardFoldersSubtitle}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,22" TextWrapping="Wrap"/>

                    <TextBlock Text="{DynamicResource WatchFolderLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,18">
                        <Button Content="{DynamicResource BrowseButton}" DockPanel.Dock="Left" Click="BrowseWatchFolder_Click"/>
                        <TextBox x:Name="WatchFolderTextBox" Margin="0,0,8,0" IsReadOnly="True"/>
                    </DockPanel>

                    <TextBlock Text="{DynamicResource OutputFolderLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button Content="{DynamicResource BrowseButton}" DockPanel.Dock="Left" Click="BrowseOutputFolder_Click"/>
                        <TextBox x:Name="OutputFolderTextBox" Margin="0,0,8,0" IsReadOnly="True"/>
                    </DockPanel>
                    <TextBlock x:Name="FoldersWarningText" Text="{DynamicResource OutputFolderWarning}" FontSize="11.5"
                               Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" Visibility="Collapsed"/>

                    <TextBlock Text="{DynamicResource OnboardWhatElseTitle}" FontWeight="SemiBold" Margin="0,26,0,10"/>
                    <CheckBox x:Name="OnboardOrganizeInstallersCheckBox" Content="{DynamicResource OrganizeInstallersCheck}" Style="{StaticResource ToggleSwitch}"/>
                    <TextBlock Text="{DynamicResource OrganizeInstallersSubtitle}" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="OnboardEnableDefenderScanCheckBox" Content="{DynamicResource EnableDefenderScanCheck}" Style="{StaticResource ToggleSwitch}" IsChecked="True"/>
                    <TextBlock Text="{DynamicResource EnableDefenderScanSubtitle}" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"/>

                    <Separator Margin="0,16,0,16" Background="{DynamicResource BorderBrush2}"/>
                    <TextBlock Text="{DynamicResource OnboardStartupTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox x:Name="OnboardStartWithWindowsCheckBox" Content="{DynamicResource StartWithWindowsCheck}"
                              Style="{StaticResource ToggleSwitch}" IsChecked="True"
                              ToolTip="{DynamicResource StartWithWindowsTooltip}"/>
                    <TextBlock Text="{DynamicResource OnboardStartupSubtitle}" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <!-- Step 3: Smart scan -->
                <DockPanel x:Name="StepScan" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{DynamicResource OnboardScanTitle}" FontSize="21" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryDarkBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{DynamicResource OnboardScanSubtitle}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,18" TextWrapping="Wrap" LineHeight="19"/>
                    </StackPanel>

                    <StackPanel x:Name="ScanPromptPanel" DockPanel.Dock="Top">
                        <Button x:Name="ScanNowButton" Content="{DynamicResource OnboardScanButton}" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" Click="ScanNowButton_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="ScanResultsPanel" DockPanel.Dock="Top" Visibility="Collapsed">
                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <TextBlock x:Name="ScanSummaryText" TextWrapping="Wrap" FontSize="13"/>
                        </Border>

                        <StackPanel x:Name="SuggestedClientsSection">
                            <TextBlock Text="{DynamicResource OnboardSuggestedClientsTitle}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                            <TextBlock Text="{DynamicResource OnboardSuggestedClientsSubtitle}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="SuggestedClientsList" MaxHeight="150">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding MatchCount, StringFormat={}{0} docs}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Bottom"/>
                </DockPanel>

                <!-- Step 4: Finish -->
                <StackPanel x:Name="StepFinish" VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="🎉" FontSize="34"/>
                    <TextBlock Text="{DynamicResource OnboardFinishTitle}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrandPrimaryDarkBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="{DynamicResource OnboardFinishSubtitle}" FontSize="13.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,20" TextWrapping="Wrap"/>
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="FinishWatchText" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock x:Name="FinishOutputText" FontSize="13" Margin="0,0,0,6"/>
                            <TextBlock x:Name="FinishClientsText" FontSize="13"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>

            <!-- Footer navigation -->
            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Content="{DynamicResource OnboardBackButton}" HorizontalAlignment="Left"
                        Visibility="Collapsed" Click="BackButton_Click"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SkipButton" Content="{DynamicResource OnboardScanSkip}" Margin="0,0,10,0" Click="SkipButton_Click"/>
                    <Button x:Name="NextButton" Content="{DynamicResource OnboardGetStartedButton}" Style="{StaticResource PrimaryButton}" Click="NextButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>

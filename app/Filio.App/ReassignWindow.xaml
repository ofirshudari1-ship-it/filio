<Window x:Class="Filio.ReassignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ReassignWindowTitle}"
        Height="420" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource BrandBackgroundBrush}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource ReassignWindowHeading}" Style="{StaticResource CardTitle}" FontSize="18"/>
        <TextBlock Grid.Row="1" x:Name="FileNameText" Text="" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,16"/>

        <!-- תוית וקומבו כל אחד בשורת Grid נפרדת (לא חופפים באותה שורה עם מרווח קבוע) -
             כך שהפריסה תתאים את עצמה גם אם הטקסט המתורגם/גודל הגופן גדל (למשל הגדלת טקסט
             בנגישות של Windows) במקום לסמוך על ערכי פיקסלים קבועים שחושבו לגודל ברירת מחדל. -->
        <TextBlock Grid.Row="2" Text="{DynamicResource ReassignClientLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="3" x:Name="ClientCombo" IsEditable="True" Padding="8,6" Margin="0,0,0,14"/>

        <TextBlock Grid.Row="4" Text="{DynamicResource ReassignDocTypeLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="5" x:Name="DocTypeCombo" IsEditable="True" Padding="8,6"/>

        <CheckBox Grid.Row="6" x:Name="LearnCheckBox" Style="{StaticResource ToggleSwitch}"
                   Content="{DynamicResource ReassignLearnLabel}" IsChecked="True" Margin="0,20,0,0"/>

        <TextBlock Grid.Row="7" x:Name="LearnHintText" Text="" FontSize="11.5" FontStyle="Italic"
                   TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" VerticalAlignment="Top"/>

        <!-- FlowDirection="LeftToRight" קבוע בכוונה (§18.1) - מוסכמת OK/Cancel של Windows עצמו
             שומרת על כפתור הפעולה הראשית (אישור) בצד ימין גם בממשק RTL, בדיוק כמו שדיאלוגים
             מובנים של Windows מציגים אותו; בלי זה, המיראור האוטומטי של FlowDirection.RightToLeft
             (שמוגדר על כל החלון) היה הופך את כל השורה לצד שמאל ומחליף את סדר הכפתורים. -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="LeftToRight" Margin="0,14,0,0">
            <Button Content="{DynamicResource CancelButton}" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="{DynamicResource ReassignConfirmButton}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>

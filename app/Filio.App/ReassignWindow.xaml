<Window x:Class="Filio.ReassignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ReassignWindowTitle}"
        Height="420" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14"
        Background="{StaticResource BrandBackgroundBrush}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource ReassignWindowHeading}" Style="{StaticResource CardTitle}" FontSize="18"/>
        <TextBlock Grid.Row="1" x:Name="FileNameText" Text="" TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="2" Text="{DynamicResource ReassignClientLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="2" x:Name="ClientCombo" IsEditable="True" Margin="0,26,0,0" Padding="8,6"/>

        <TextBlock Grid.Row="3" Text="{DynamicResource ReassignDocTypeLabel}" FontWeight="SemiBold" Margin="0,16,0,4"/>
        <ComboBox Grid.Row="3" x:Name="DocTypeCombo" IsEditable="True" Margin="0,42,0,0" Padding="8,6"/>

        <CheckBox Grid.Row="4" x:Name="LearnCheckBox" Style="{StaticResource ToggleSwitch}"
                   Content="{DynamicResource ReassignLearnLabel}" IsChecked="True" Margin="0,20,0,0"/>

        <TextBlock Grid.Row="5" x:Name="LearnHintText" Text="" FontSize="11.5" FontStyle="Italic"
                   TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource CancelButton}" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="{DynamicResource ReassignConfirmButton}" Style="{StaticResource PrimaryButton}" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>

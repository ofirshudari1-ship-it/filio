<Window x:Class="Filio.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="300" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">
    <Border CornerRadius="18" ClipToBounds="True">
        <!-- Brand gradient straight from assets/BRAND.md / design-tokens.json:
             primary-dark (#0F5348) -> primary (#1E7F72), Filio's own teal palette,
             not a white/gray/framework default. -->
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F5348" Offset="0"/>
                <GradientStop Color="#1E7F72" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,0">
                <!-- Real Filio mark as the large, dominant, centered element -->
                <Image Source="/Assets/filio-128.png" Width="108" Height="108" Margin="0,0,0,16"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Filio" FontSize="30" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                <TextBlock x:Name="TaglineText" Text="{DynamicResource AppTagline}" FontSize="13"
                           Foreground="#DFF3EF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock x:Name="VersionText" Text="v2.7.0" FontSize="11"
                           Foreground="#99C5BF" HorizontalAlignment="Center" Margin="0,4,0,20"/>

                <!-- Continuous spinner (not a fake progress bar) - a partial ring that rotates
                     forever while status text underneath reports real stages. -->
                <Grid Width="28" Height="28" HorizontalAlignment="Center">
                    <Ellipse Width="28" Height="28" StrokeThickness="3" Stroke="#26FFFFFF"/>
                    <Path Width="28" Height="28" Stroke="#DB8A1F" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 14,1 A 13,13 0 1 1 2.5,8"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                </Grid>

                <TextBlock x:Name="StatusText" Text="Loading…" FontSize="11"
                           Foreground="#99C5BF" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Border>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:0.9"
                                     RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Filio</AssemblyName>
    <RootNamespace>Filio</RootNamespace>
    <ApplicationIcon>Assets\filio.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.9.0</Version>
    <Product>Filio</Product>
    <Company>Filio</Company>
    <AssemblyTitle>Filio</AssemblyTitle>
    <Description>Filio automatically files your downloads by client, date and document type.</Description>
    <!-- Publish as a single self-contained file for the installer -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="Tesseract" Version="5.2.0" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- נתוני שפה ל-OCR מקומי (אנגלית + עברית) - נדרשים בתיקייה "tessdata" לצד ה-exe. -->
    <Content Include="tessdata\*.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- לוגו Filio (מיוצא מ-design-source/filio_logo_master.svg) - נטען דרך pack URI
         ב-XAML (Splash/Header/Onboarding). -->
    <Resource Include="Assets\filio-*.png" />
  </ItemGroup>

  <!-- dotnet publish עם PublishSingleFile=true לא מעתיק לתיקיית הפרסום קבצי Content/None
       "רגילים" (כולל את ה-DLL-ים הילידיים של Tesseract ואת tessdata) - ה-pipeline של
       ResolvedFileToPublish פשוט מתעלם מהם במצב הזה. לכן מעתיקים אותם ידנית אחרי הפרסום,
       ישירות מנתיב חבילת ה-NuGet (PkgTesseract, נוצר בזכות GeneratePathProperty למעלה)
       ומתיקיית המקור tessdata - כך שהם תמיד יגיעו לתיקיית הפרסום הסופית, לא משנה אילו
       תככי MSBuild משתנים בגרסת ה-SDK. -->
  <Target Name="CopyOcrAssetsAfterPublish" AfterTargets="Publish">
    <ItemGroup>
      <OcrTessData Include="tessdata\*.traineddata" />
      <OcrNativeDlls Include="$(PkgTesseract)\x64\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(OcrTessData)" DestinationFolder="$(PublishDir)tessdata\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(OcrNativeDlls)" DestinationFolder="$(PublishDir)x64\" SkipUnchangedFiles="true" />
  </Target>

</Project>
